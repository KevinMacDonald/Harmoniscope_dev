// Station mapping configuration file. Defines which daemons should be 
// run for a given station ID.
{
   // A hash mapping station IDs to IP addresses.
   "stations": {
        "0": {
            "ip_address": "127.0.0.1"
        },
        "1": {
            "ip_address": "127.0.0.1"
        },
        "2": {
            "ip_address": "127.0.0.1"
        },
        "3": {
            "ip_address": "127.0.0.1"
        },
        "4": {
            "ip_address": "127.0.0.1"
        },
        "5": {
            "ip_address": "127.0.0.1"
        },
        "6": {
            "ip_address": "127.0.0.1"
        },
        "7": {
            "ip_address": "127.0.0.1"
        },
        "8": {
            "ip_address": "127.0.0.1"
        }
    },

    // An array of hashes, one for each possible process that we have.
    "daemons": [
        {
            "name":        "master-controller",
            "description": "The master controller process that takes in station state information and generates events",
            "runs_on_stations": [ "3" ]
        },
        {
            "name":        "light-server",
            "description": "The light control process that recieves light events from the master controller",
            "runs_on_stations": [ "3" ]
        },
        {
            "name":        "control-scan",
            "description": "The process that reads in knob input settings and sends them to the master controller",
            "runs_on_stations": [ "3" ]
        },
        {
            "name":        "sound-server",
            "description": "The audio control service that recieves sound events for a station from the master controller",
            "runs_on_stations": [ "3" ]
        }
    ]
}
